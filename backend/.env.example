# Runtime configuration. Copy to .env locally; inject secrets from deployment configuration.
PORT=8085
PG_CONN_STR=postgres://postgres:password@localhost:5432/puja_vahini?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/puja_vahini?sslmode=disable
JWT_SECRET=your-32-byte-secret-key-change-in-production
TRUSTED_PROXIES=127.0.0.1,::1

# Firebase Cloud Messaging Service Account (JSON string or path to JSON file)
FCM_SERVICE_ACCOUNT_JSON=

# Email / SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_BASE_URL=https://pilot.pujavaahini.in

# Redis Cache & Session state
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Exact browser origins, comma-separated (no wildcard). Native clients omit Origin.
ALLOWED_ORIGINS=http://localhost:3000,https://admin.pujavaahini.in
PUBLIC_API_URL=http://localhost:8085

# Compose infrastructure credentials (use independent random secrets).
POSTGRES_PASSWORD=
TURN_USER=
TURN_PASSWORD=
